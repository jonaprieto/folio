#!/usr/bin/env python3
"""folio: search LibGen, download by md5 via Anna's Archive record data;
open-access papers come straight from their publisher or arXiv.

  folio [query...]          interactive: search, pick by number, download; at the prompt,
                            m pages through results, any text is a new search
                            (/text forces a search, e.g. /1984)
  folio search <query...>   title, author, ISBN or DOI (bare or URL) -> md5 list;
                            a DOI, arXiv id or link to a paper's page also lists its
                            open-access PDF first, when the page offers one;
                            filters: -n N, --ext pdf,epub,
                            --year 2015-2020, --lang English, --articles | --books;
                            --json for machine output; exits 1 on no results
  folio info <md5>          Anna's Archive record summary
  folio get <md5>... [-o DIR]
                            download (AA member API if AA_KEY set, then LibGen, then IPFS);
                            prints each saved path, exits 1 if any failed
  folio get <doi|arxiv|link>... [-o DIR]
                            download the open-access PDF: 10.4230/LIPIcs.ECOOP.2023.9,
                            arXiv:1706.03762, https://drops.dagstuhl.de/entities/document/...
  folio torrent <md5>       magnet + file path inside torrent

Files are renamed like papershelf's Reference preset, [year]-[author:surname]-[title:truncate40]
(2022-cormen-introduction-to-algorithms-4.pdf), and opened after an interactive download.

When no known LibGen mirror answers, folio asks open-slum.org (an uptime monitor) for newer
domains, and puts its report in the error.

Env:
  FOLIO_DIR     download folder (default ~/Downloads)
  FOLIO_NAME    filename pattern with [author] [year] [title]; "original" keeps the server's name
  FOLIO_OPEN    0 to not open files after download
  AA_KEY        Anna's Archive member secret key
  AA_DOMAIN     default annas-archive.gl;  LG_DOMAIN  default libgen.li
"""
import argparse, functools, hashlib, html, json, os, re, shutil, subprocess, sys, textwrap, unicodedata
import urllib.error, urllib.parse, urllib.request

AA = "https://" + os.environ.get("AA_DOMAIN", "annas-archive.gl")
# ponytail: mirrors from a 2026-09 probe, all serving the same data; LG_DOMAIN goes first.
MIRRORS = list(dict.fromkeys([os.environ.get("LG_DOMAIN", "libgen.li"),
                              "libgen.li", "libgen.bz", "libgen.gl", "libgen.vg", "libgen.la"]))
LG = "https://" + MIRRORS[0]  # the last mirror that answered
SLUM = "https://open-slum.org/"  # shadow-library uptime monitor: asked only once every mirror above fails
UA = {"User-Agent": "Mozilla/5.0"}
# Publishers get an honest name: Zenodo and eLife turn away a bare "Mozilla/5.0" but serve this.
OA_UA = {"User-Agent": "folio (+https://github.com/jonaprieto/folio)"}
COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
EXT_COLOR = dict(pdf="44", epub="42", mobi="43", azw3="43", djvu="45", fb2="46")  # bg; red stays for errors
DOI = re.compile(r"10\.\d{4,9}/\S+")
# arXiv:1706.03762, arxiv.org/abs/... or /pdf/..., old ids like hep-th/9901001; a bare new-style id too
ARXIV = re.compile(r"(?:(?:https?://)?(?:www\.)?arxiv\.org/(?:abs|pdf)/|arxiv:\s*)"
                   r"([a-z-]+(?:\.[a-z]{2})?/\d{7}(?:v\d+)?|\d{4}\.\d{4,5}(?:v\d+)?)(?:\.pdf)?"
                   r"|(\d{4}\.\d{4,5}(?:v\d+)?)", re.I)
OUTDIR = os.path.expanduser(os.environ.get("FOLIO_DIR", "~/Downloads"))
NAME = os.environ.get("FOLIO_NAME", "[year]-[author]-[title]")


def c(s, code):
    return f"\033[{code}m{s}\033[0m" if COLOR else str(s)


def err(s, code="2"):
    print(c(s, code) if sys.stderr.isatty() else s, file=sys.stderr)
# ponytail: hardcoded from a 2026-09 probe; reorder when gateways die.
GOOD_GATEWAYS = ["ipfs.orbitor.dev", "snapshot.4everland.link", "ipfs.raribleuserdata.com",
                 "ipfs.filebase.io", "magic.decentralized-content.com"]


def fetch(url, timeout=30, headers=UA):
    return urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=timeout)


def text(url):
    return fetch(url).read(8 << 20).decode("utf-8", "replace")  # cap: pages are ~100 KB


@functools.lru_cache(None)
def slum():
    """{domain: status} for LibGen from open-slum.org, or {} when it does not answer."""
    # ponytail: scrapes FlatMonitor's HTML (it has no JSON); a redesign there turns this into {}.
    try:
        card = text(SLUM).split('site-card-title">libgen</a>', 1)[1].split('class="site-card"', 1)[0]
    except Exception:
        return {}
    return dict(m.groups() for li in card.split("domain-item-dense")[1:]
                if (m := re.search(r'href="https://([\w-]+(?:\.[\w-]+)+)".*?status-badge compact (\w+)', li, re.S)))


def mirrors():
    """LibGen base URLs, the last one that answered first; past those, the new domains open-slum.org
    reports up, so a LibGen move needs no folio release. Lazy: the monitor is asked only when reached."""
    known = [LG] + [u for u in ("https://" + d for d in MIRRORS) if u != LG]
    yield from known
    yield from ("https://" + d for d, s in slum().items()
                if "https://" + d not in known and s in ("up", "protected", "degraded"))


def lg_text(path):
    """GET path from the first LibGen mirror that answers, and remember it."""
    global LG
    for m in mirrors():
        try:
            page = text(m + path)
        except Exception as e:
            err(f"  {m[8:]}: {e}", "33")
            continue
        LG = m
        return page
    status = ", ".join(f"{d} {s}" for d, s in slum().items())
    raise OSError(f"no LibGen mirror answered ({', '.join(MIRRORS)})"
                  + (f"; {SLUM[8:-1]} reports {status}" if status else ""))


def safe(s):
    """Drop control chars (ESC, C1, ...) from remote text before it reaches the terminal."""
    return re.sub(r"[\x00-\x1f\x7f-\x9f]", "", str(s))


def strip(s):
    s = re.sub(r'\s[\w-]+="[^"]*"', "", s[:5000])  # attrs first: libgen tooltips contain "<br>"
    return safe(re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", " ", s))).strip())


def safe_name(name, md5):
    """Server-chosen filename -> plain basename: no dirs, no dotfiles, no control chars, bounded length."""
    name = safe(os.path.basename(name.replace("\\", "/"))).strip().lstrip(".")
    stem, ext = os.path.splitext(name)
    stem, ext = stem.encode()[:180].decode("utf-8", "ignore").strip(), ext[:10]
    return (stem or md5) + ext


def free_path(outdir, name, md5):
    """Never overwrite: add the md5 prefix when the name is taken."""
    path = os.path.join(outdir, name)
    if os.path.exists(path):
        stem, ext = os.path.splitext(name)
        path = os.path.join(outdir, f"{stem} ({md5[:8]}){ext}")
    return path


def is_isbn(d):
    if len(d) == 13:
        return d[:3] in ("978", "979")
    return sum((10 - i) * (10 if ch in "Xx" else int(ch)) for i, ch in enumerate(d)) % 11 == 0


def split_authors(a):
    """'A; B', 'A & B', 'A and B', or 'First Last, First Last'; keeps 'Last, First' as one name."""
    parts = [x.strip() for x in re.split(r"\s*[;&]\s*|\s+and\s+", a) if x.strip()]
    if len(parts) == 1 and "," in a:
        comma = [x.strip() for x in a.split(",") if x.strip()]
        if all(len(x.split()) >= 2 for x in comma):  # every piece is a full name
            parts = comma
    return [re.sub(r"\s*\(.*?\)", "", x).strip() for x in parts]


def parse_libgen(page):
    table = re.search(r'<table[^>]*id="tablelibgen".*?</table>', page, re.S)
    out = []
    for row in re.findall(r"<tr>.*?</tr>", table.group(0) if table else "", re.S):
        cells = re.findall(r"<td[^>]*>(.*?)</td>", row, re.S)
        md5 = re.search(r"md5=([0-9a-fA-F]{32})", row)
        if len(cells) < 9 or not md5 or md5.group(1).lower() in {r["md5"] for r in out}:
            continue
        title = strip(re.sub(r'<span class="badge.*?</span>', "", cells[0], flags=re.S))
        title = re.sub(r"[\s;,]{0,4}(?:ISBN[:\s]*)?\b(97[89]\d{10}|\d{9}[\dXx])\b",
                       lambda m: "" if is_isbn(m.group(1)) else m.group(0), title)
        title = re.sub(r"\s*DOI:\s*\S+|\s*ISBN:?\s*$", "", title).strip()  # ISBN/DOI noise
        title = title.split(" || ")[0].strip()
        title = re.sub(r"^(.{6,}?)\s+\1\b", r"\1", title)  # series prefix repeats the title
        author = re.sub(r"\s*\((?:author|auth\.|editor|ed\.)\)|\s*\[\.\.\.\]\s*;?", "", strip(cells[1]), flags=re.I)
        out.append(dict(md5=md5.group(1).lower(), title=title[:200], author=author[:120],
                        year=strip(cells[3]), lang=strip(cells[4])[:20], size=strip(cells[6]),
                        ext=strip(cells[7])[:8], article='title="Journal article"' in row))
    # same title+format+size is the same book uploaded twice: keep the first
    seen, uniq = set(), []
    for r in out:
        k = (re.sub(r"\W+", "", r["title"].lower()), re.sub(r"\W+", "", r["author"].lower()),
             r["year"][:4], r["ext"], r["size"])
        if k not in seen:
            seen.add(k)
            uniq.append(r)
    return sorted(uniq, key=lambda r: r["article"])  # books first, stable


def record(md5):
    """Full AA record, or None: it is members-only for most md5s (403)."""
    try:
        return json.load(fetch(f"{AA}/db/aarecord_elasticsearch/md5:{md5}.json"))
    except urllib.error.HTTPError as e:
        if e.code == 403:
            return None
        raise


def sources(md5, rec):
    key = os.environ.get("AA_KEY")
    if key:
        try:
            r = json.load(fetch(f"{AA}/dyn/api/fast_download.json?md5={md5}&key={urllib.parse.quote(key)}"))
            if str(r.get("download_url")).startswith("https://"):
                yield "aa-fast", r["download_url"]
            else:
                print(f"  aa-fast: {r.get('error')}", file=sys.stderr)
        except Exception as e:
            print(f"  aa-fast: {e}", file=sys.stderr)
    for m in mirrors():  # a mirror whose get.php fails falls through to the next
        try:
            get = re.search(r'href="(get\.php\?md5=[^"]+)"', text(f"{m}/ads.php?md5={md5}"))
        except Exception as e:
            err(f"  {m[8:]}: {e}", "33")
            continue
        if not get:
            break  # mirrors share one database: absent here, absent everywhere
        yield m[8:], f"{m}/" + html.unescape(get.group(1))
    cids = []
    for u in (rec or {}).get("additional", {}).get("ipfs_urls") or []:
        cid = u.get("url", "").partition("/ipfs/")[2].split("?")[0]
        if re.fullmatch(r"[A-Za-z0-9]+", cid) and cid not in cids:
            cids.append(cid)
    for cid in cids:
        for gw in GOOD_GATEWAYS:
            yield gw, f"https://{gw}/ipfs/{cid}"


def download(url, outdir, md5, name):
    """Stream to outdir; keep it only if the md5 matches (gateways happily serve HTML with 200/206).

    md5 None is an open-access PDF: nothing to match, so it must at least start like a PDF.
    """
    h, head = hashlib.md5(), b""
    tmp = os.path.join(outdir, (md5 or hashlib.md5(url.encode()).hexdigest()) + ".part")
    try:
        with fetch(url, 60, UA if md5 else OA_UA) as r, open(tmp, "wb") as f:
            cd = re.search(r"filename\*?=(?:UTF-8'')?\"?([^\";]+)", r.headers.get("Content-Disposition", ""))
            size, done = int(r.headers.get("Content-Length") or 0), 0
            while chunk := r.read(1 << 16):
                head = head or chunk[:1024]
                h.update(chunk)
                f.write(chunk)
                done += len(chunk)
                if sys.stderr.isatty():
                    pct = f"{100 * done // size}%" if size else ""
                    print(f"\r  {done >> 20} MB {pct}   ", end="", file=sys.stderr)
        if sys.stderr.isatty():
            print(file=sys.stderr)
        digest = h.hexdigest()
        if digest != md5 if md5 else b"%PDF" not in head:
            return None
        name = name or (urllib.parse.unquote(cd.group(1)) if cd else digest + (".bin" if md5 else ".pdf"))
        path = free_path(outdir, safe_name(name, digest), digest)
        os.replace(tmp, path)
        return path
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def normalize_query(query):
    """DOI resolver URL or doi: identifier -> bare DOI; leave other searches alone."""
    candidate = re.sub(r"^doi:\s*", "", query.strip(), flags=re.I)
    resolver = re.match(r"^(?:https?://|//)?(?:dx\.)?doi\.org/", candidate, re.I)
    if resolver:
        candidate = candidate[resolver.end():].split("?", 1)[0].split("#", 1)[0]
    candidate = urllib.parse.unquote(candidate)
    return candidate if DOI.fullmatch(candidate) else query


def oa_landing(query):
    """DOI, arXiv id or link -> the page that may offer an open-access PDF, else None."""
    q = normalize_query(query).strip()
    if m := ARXIV.fullmatch(q):
        return "https://arxiv.org/abs/" + (m.group(1) or m.group(2))
    if DOI.fullmatch(q):
        return "https://doi.org/" + urllib.parse.quote(q)
    return q if re.fullmatch(r"https?://\S+", q, re.I) else None


def open_access(query):
    """Result row for a DOI, arXiv id or link whose page offers a free PDF, else None.

    Open-access publishers (DROPS, arXiv, ...) name the PDF in a citation_pdf_url meta tag,
    Google Scholar's convention, or in a <link type="application/pdf"> (Zenodo). Paywalled ones may too, so the row is returned only when
    that URL really serves a PDF.
    """
    page = oa_landing(query)
    if not page:
        return None
    try:
        with fetch(page, 15, OA_UA) as r:
            base, direct = r.geturl(), r.headers.get_content_type() == "application/pdf"
            body = "" if direct else r.read(2 << 20).decode("utf-8", "replace")
        meta = {}
        for tag in re.findall(r"<meta\b[^>]*>", body, re.I):
            k = re.search(r"""\bname=["']?(citation_\w+)""", tag, re.I)
            v = re.search(r"""\bcontent=(?:"([^"]*)"|'([^']*)'|([^\s>]+))""", tag, re.I)  # ACL leaves quotes off
            if k and v:
                meta.setdefault(k.group(1).lower(), []).append(safe(html.unescape(next(filter(None, v.groups()), ""))).strip())
        for tag in re.findall(r"<link\b[^>]*>", body, re.I):  # Zenodo's way: <link rel="item" type="application/pdf">
            href = re.search(r"""\bhref=["']([^"']+)""", tag, re.I)
            if href and re.search(r"""\brel=["']?(?:item|alternate)\b""", tag, re.I) and "application/pdf" in tag.lower():
                meta.setdefault("citation_pdf_url", []).append(html.unescape(href.group(1)))
        url = base if direct else urllib.parse.urljoin(base, (meta.get("citation_pdf_url") or [""])[0])
        if not (direct or meta.get("citation_pdf_url")) or not re.match(r"https?://", url, re.I):
            return None
        with fetch(url, 15, OA_UA) as r:
            if b"%PDF" not in r.read(1024):
                return None
            size = int(r.headers.get("Content-Length") or 0)
    except Exception as e:
        return err(f"  no open-access PDF from {urllib.parse.urlsplit(page).netloc}: {e}")
    date = " ".join(meta.get(k, [""])[0] for k in ("citation_date", "citation_publication_date", "citation_online_date"))
    title = (meta.get("citation_title") or [urllib.parse.unquote(os.path.basename(urllib.parse.urlsplit(url).path))])[0]
    return dict(md5="", title=title[:200], author="; ".join(a[:60] for a in meta.get("citation_author", [])[:10]),
                year=(re.search(r"\d{4}", date) or [""])[0], lang="",
                size=f"{size >> 20} MB" if size >> 20 else f"{size >> 10} kB" if size else "",
                ext="pdf", article=True, url=url, page=page)


def search(args, page=1):
    """One LibGen page -> (rows, more): more is False once a page comes back short.

    A DOI, arXiv id or link also gets its open-access PDF, as the first row of page 1.
    """
    query = normalize_query(' '.join(args))
    oa = [r for r in [open_access(query)] if r] if page == 1 else []
    if oa_landing(query) and not DOI.fullmatch(query):
        return oa, False  # an arXiv id or a link: nothing LibGen can match
    try:
        html_ = lg_text(f"/index.php?req={urllib.parse.quote_plus(query)}&res=100&page={page}")
    except OSError:
        if not oa:
            raise
        return oa, False  # LibGen is down but the paper is open access anyway
    rows = parse_libgen(html_)
    return oa + rows, len(set(re.findall(r"md5=([0-9a-fA-F]{32})", html_))) >= 100


def wanted(r, o):
    """Does a result pass the search filters?"""
    y = (re.search(r"\d{4}", r["year"]) or [""])[0]
    lo, dash, hi = (o.year or "").partition("-")
    hi = hi or ("9999" if dash else lo)
    return ((not o.ext or r["ext"].lower() in o.ext.lower().split(","))
            and (not o.lang or o.lang.lower() in r["lang"].lower())
            and (not o.year or bool(y) and (lo or "0000") <= y <= hi)
            and not (o.articles and not r["article"]) and not (o.books and r["article"]))


def cmd_search(args):
    ap = argparse.ArgumentParser(prog="folio search", description="Search LibGen by title, author, ISBN or DOI (bare or URL); one result per line, or JSON. "
                                 "A DOI, arXiv id or link also lists its open-access PDF first: pass that row's link to folio get.")
    ap.add_argument("query", nargs="+")
    ap.add_argument("-n", type=int, default=20, help="max results (default 20)")
    ap.add_argument("--ext", help="formats, comma-separated: pdf,epub")
    ap.add_argument("--year", help="2017, or a range: 2015-2020, 2015-, -2000")
    ap.add_argument("--lang", help="language, e.g. English")
    kind = ap.add_mutually_exclusive_group()
    kind.add_argument("--articles", action="store_true", help="journal articles only")
    kind.add_argument("--books", action="store_true", help="books only")
    ap.add_argument("--json", action="store_true", help="JSON array of results")
    o = ap.parse_args(args)
    found, seen = [], set()
    try:
        for page in range(1, 6):  # ponytail: 5 pages (500 rows) is plenty to fill -n after filtering
            rows, more = search(o.query, page)
            found += [r for r in rows if r["md5"] not in seen and wanted(r, o)]
            seen |= {r["md5"] for r in rows}
            if len(found) >= o.n or not more:
                break
    except Exception as e:
        sys.exit(f"search failed: {e}")
    found = found[:o.n]
    if o.json:
        print(json.dumps(found, ensure_ascii=False, indent=1))
    else:
        for r in found:
            kind = "article" if r["article"] else "book"
            print(f"{r['md5'] or r['page']}  {r['ext']:5} {r['size']:>8}  {r['year'][:4]:4}  {kind:7}  {r['title']} / {r['author']}")
    if not found:
        err("no results")
        sys.exit(1)


def cmd_info(args):
    md5 = args[0].lower()
    rec = record(md5)
    label = lambda k: c(f"  {k:<9}", "2")
    if not rec:
        print(label("md5") + md5)
        print(label("record") + c("members-only on Anna's Archive", "33"))
        print(label("libgen") + f"{LG}/ads.php?md5={md5}")
        return
    fu, add = rec["file_unified_data"], rec["additional"]
    print("  " + c(safe(fu.get("title_best")), "1"))
    print(label("author") + c(safe(fu.get("author_best")), "36"))
    print(label("file") + safe(f"{fu.get('extension_best')}, {int(fu.get('filesize_best') or 0) >> 20} MB, {fu.get('year_best')}"))
    print(label("name") + safe(urllib.parse.unquote(add.get("filename") or "")))
    for t in add.get("torrent_paths") or []:
        print(label("torrent") + safe(f"{t['torrent_path']} ({t['file_level1']})"))
    for name, url, _ in add.get("download_urls") or []:
        print(label("mirror") + f"{c(safe(name), '36')}  {safe(url)}")


def slug(s, limit=60):
    s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode().lower()
    s = re.sub(r"[^a-z0-9]+", "-", s).strip("-")
    if len(s) <= limit or s[limit] == "-":
        return s[:limit]
    return s[:limit].rsplit("-", 1)[0]


def surname(author):
    """First author's family name: 'Cormen, Thomas H.' and 'Thomas H. Cormen' both give Cormen."""
    first = (split_authors(author) or [""])[0]
    return first.split(",")[0] if "," in first else (first.split() or [""])[-1]


def nice_name(title, author, year, ext):
    """papershelf Reference preset: [year]-[author:surname]-[title:truncate40], lowercase slugs."""
    fields = dict(author=slug(surname(author or ""), 30), year=(re.search(r"\d{4}", year or "") or [""])[0],
                  title=slug(title or "", 40))
    name = re.sub(r"\[(\w+)\]", lambda m: fields.get(m.group(1), ""), NAME)
    name = re.sub(r"-{2,}", "-", name).strip("-")
    return f"{name}.{ext}" if name and ext else None


def open_file(path):
    if os.environ.get("FOLIO_OPEN", "1") != "0":
        try:
            subprocess.run(["open" if sys.platform == "darwin" else "xdg-open", path],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass


def lg_meta(md5):
    """(title, author, year, ext) from LibGen's JSON API, or None if it does not know the md5."""
    try:
        f = next(iter(json.loads(lg_text(f"/json.php?object=f&md5={md5}")).values()))
        eid = next(iter(f["editions"].values()))["e_id"]
        e = next(iter(json.loads(lg_text(f"/json.php?object=e&ids={eid}")).values()))
        return e.get("title"), e.get("author"), e.get("year"), f.get("extension")
    except Exception:
        return None


def get_file(md5, outdir=OUTDIR, name=None):
    """name: preferred filename (papershelf style); None falls back to the record's or the server's."""
    try:
        rec = record(md5)
    except Exception:
        rec = None  # AA down or blocked: LibGen may still have it
    if rec and not name:
        fu = rec["file_unified_data"]
        name = None if NAME == "original" else nice_name(
            fu.get("title_best"), fu.get("author_best"), fu.get("year_best"), fu.get("extension_best"))
        name = name or urllib.parse.unquote(rec["additional"].get("filename") or "") or None
    elif not name and NAME != "original" and (meta := lg_meta(md5)):
        name = nice_name(*meta)  # no AA membership: LibGen knows the title too
    for label, url in sources(md5, rec):
        err(f"  trying {label} ...")
        try:
            if path := download(url, outdir, md5, name):
                return path
            err(f"  {label}: md5 mismatch", "33")
        except Exception as e:
            err(f"  {label}: {e}", "33")
    err(f"  all sources failed; try `folio torrent {md5}`", "31")


def get_oa(r, outdir=OUTDIR):
    """Download an open-access row from open_access()."""
    name = None if NAME == "original" else nice_name(r["title"], r["author"], r["year"], "pdf")
    err(f"  trying {urllib.parse.urlsplit(r['url']).netloc} ...")
    try:
        if path := download(r["url"], outdir, None, name):
            return path
        err("  not a PDF", "33")
    except Exception as e:
        err(f"  {e}", "33")


def cmd_get(args):
    ap = argparse.ArgumentParser(prog="folio get", description="Download files by md5, or open-access papers by DOI, arXiv id or link; prints each saved path.")
    ap.add_argument("md5", nargs="+", metavar="id", help="md5 from search, or a DOI, arXiv id or link to an open-access paper")
    ap.add_argument("-o", metavar="DIR", default=OUTDIR, help=f"download folder (default {OUTDIR})")
    o = ap.parse_args(args)
    is_md5 = lambda m: re.fullmatch(r"[0-9a-fA-F]{32}", m)
    bad = [m for m in o.md5 if not is_md5(m) and not oa_landing(m)]
    if bad:
        sys.exit(f"not an md5, DOI, arXiv id or link: {bad[0]!r}")
    if not os.path.isdir(o.o):
        sys.exit(f"no such directory: {o.o}")
    failed = 0
    for m in o.md5:
        if is_md5(m):
            path = get_file(m.lower(), o.o)
        elif r := open_access(m):
            path = get_oa(r, o.o)
        else:
            path = err(f"  no open-access PDF for {m}; `folio search` looks for it in LibGen", "33")
        if path:
            print(path)
        failed += not path
    sys.exit(1 if failed else 0)


